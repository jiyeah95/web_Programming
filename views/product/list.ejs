<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>추천 상품</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header>

    <div class="login-area">

        <% if(!user){ %>

            <a href="/user/login">로그인</a>
            |
            <a href="/user/register">회원가입</a>

        <% } else { %>

            <span>
                <%= user.name %>님 환영합니다.
            </span>

            |
            <a href="/user/logout">로그아웃</a>

        <% } %>

    </div>

</header>

<nav class="menu">

    <a href="/">홈</a>
    <a href="/product">추천상품</a>
    <a href="/product/all">전체상품</a>
    <a href="/cart">장바구니</a>
    <a href="/order">주문내역</a>
    <a href="/board">고객센터</a>

</nav>

<div class="page-title">

    <h1>🍓 오늘의 과일 추천</h1>

    <p>
        현재 등록 상품 수 :
        <strong><%= allProducts.length %></strong>개
    </p>

</div>

<div class="products">

    <% featuredProducts.forEach(product => { %>

        <div class="product-card">

            <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
            >

            <h3>
                <%= product.emoji %>
                <%= product.name %>
            </h3>

            <p class="description">
                <%= product.description %>
            </p>

            <p class="price">
                ₩<%= product.price.toLocaleString() %>
            </p>

            <p>
                👍 좋아요 <%= product.likes %>
            </p>

            <form action="/cart/add/<%= product.id %>" method="POST">

                <button type="submit">
                    🛒 장바구니 담기
                </button>

            </form>

        </div>

    <% }) %>

</div>

<div style="text-align:center; margin-top:40px;">

    <a href="/product/all">
        전체 상품 보러가기 →
    </a>

</div>

</body>
</html>