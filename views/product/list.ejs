<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>추천 상품</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <%- include('../partials/header') %>
</head>
<body>

<div class="page-title">

    <h1>🍓 오늘의 과일 추천</h1>

    <a href="/product/all" class="all-product-btn">
        🛍 전체 상품 보기
    </a>

    <p>
        현재 등록 상품 수 :
        <strong><%= allProducts.length %></strong>개
    </p>

</div>

<div class="products">

    <% featuredProducts.forEach(product => { %>

        <div class="product-card">

            <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
            >

            <h3>
                <%= product.emoji %>
                <%= product.name %>
            </h3>

            <p class="description">
                <%= product.description %>
            </p>

            <p class="price">
                ₩<%= product.price.toLocaleString() %>
            </p>

            <p>
                👍 좋아요 <%= product.likes %>
            </p>

            <form action="/cart/add/<%= product.id %>" method="POST">

                <input
                        type="hidden"
                        name="returnUrl"
                        value="/product">

                <button type="submit">
                    🛒 장바구니 담기
                </button>

            </form>
            <form
                    action="/product/wishlist/<%= product.id %>"
                    method="POST">

                <button
                        type="submit"
                        style="
            margin-top:8px;
            background:#ff5a7a;
            color:white;
            border:none;
            padding:10px;
            border-radius:5px;
            cursor:pointer;
            ">

                    ❤️ 찜하기

                </button>

            </form>

        </div>

    <% }) %>

</div>


</body>
</html>