<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>추천 상품</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <%- include('../partials/header') %>
</head>
<body>

<div class="page-title">

    <h1>🍓 오늘의 과일 추천</h1>

    <a href="/product/all" class="all-product-btn">
        🛍 전체 상품 보기
    </a>

    <p>
        현재 등록 상품 수 :
        <strong><%= allProducts.length %></strong>개
    </p>

</div>

<div class="products">

    <% featuredProducts.forEach(product => { %>

        <div
                class="product-card"
                onclick="location.href='/product/detail/<%= product.id %>'"
                style="cursor:pointer;">

            <a href="/product/detail/<%= product.id %>">

                <img
                        src="<%= product.image %>"
                        alt="<%= product.name %>">

            </a>

            <h3>

                <a
                        href="/product/detail/<%= product.id %>"
                        style="
                text-decoration:none;
                color:black;
            ">

                    <%= product.emoji %>
                    <%= product.name %>

                </a>

            </h3>

            <p class="description">
                <%= product.description %>
            </p>

            <p class="price">
                ₩<%= product.price.toLocaleString() %>
            </p>

            <p>
                👍 좋아요 <%= product.likes %>
            </p>

            <form
                    action="/cart/add/<%= product.id %>"
                    method="POST"
                    onsubmit="return askCart()">

                <input
                        type="hidden"
                        name="returnUrl"
                        value="/product">

                <button type="submit">
                    🛒 장바구니 담기
                </button>

            </form>
            <form
                    action="/product/wishlist/<%= product.id %>"
                    method="POST">

                <button
                        type="submit"
                        style="
            margin-top:8px;
            background:#ff5a7a;
            color:white;
            border:none;
            padding:10px;
            border-radius:5px;
            cursor:pointer;
            ">

                    ❤️ 찜하기

                </button>

            </form>

        </div>

    <% }) %>

</div>

<script>

    const params = new URLSearchParams(window.location.search);

    if (params.get("cart") === "1") {

        if (confirm("🛒 상품이 장바구니에 담겼습니다.\n장바구니로 이동하시겠습니까?")) {

            location.href = "/cart";
        }
    }

</script>

</body>
</html>