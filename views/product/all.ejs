<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>전체 상품 목록</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <%- include('../partials/header') %>
</head>
<body>

<div class="page-title">

    <h1>🛍 전체 상품 목록</h1>

    <a href="/product" class="recommend-btn">
        🍓 추천 상품 보기
    </a>

    <p>
        다양한 신선 과일을 만나보세요.
    </p>

</div>

<div class="products">

    <% products.forEach(product => { %>

        <div class="product-card">

            <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
            >

            <h3>
                <%= product.emoji %>
                <%= product.name %>
            </h3>

            <p class="description">
                <%= product.description %>
            </p>

            <p class="price">
                ₩<%= product.price.toLocaleString() %>
            </p>

            <form action="/cart/add/<%= product.id %>" method="POST">

                <input
                        type="hidden"
                        name="returnUrl"
                        value="/product/all">

                <button type="submit">
                    🛒 장바구니 담기
                </button>

            </form>
            <form
                    action="/product/wishlist/<%= product.id %>"
                    method="POST">

                <button
                        type="submit"
                        style="
            margin-top:8px;
            background:#ff5a7a;
            color:white;
            border:none;
            padding:10px;
            border-radius:5px;
            cursor:pointer;
            ">

                    ❤️ 찜하기

                </button>

            </form>

        </div>

    <% }) %>

</div>

</body>
</html>