<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>주문내역</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <%- include('partials/header') %>
</head>
<body>
<div class="page-title">

    <h1>📦 주문 내역</h1>

    <p>
        지금까지 주문한 상품 목록입니다.
    </p>

</div>

<div class="cart-container">

    <% if(orders.length === 0){ %>

        <div class="empty-cart">

            주문 내역이 없습니다.

        </div>

    <% } else { %>

        <table class="cart-table">

            <tr>
                <th>내 주문번호</th>
                <th>총금액</th>
                <th>주문일</th>
                <th>상세보기</th>
            </tr>

            <% orders.forEach(order => { %>

                <tr>

                    <td>
                        <%= order.order_no %>
                    </td>

                    <td>
                        ₩<%= order.total_price.toLocaleString() %>
                    </td>

                    <td>
                        <%= order.created_at_kor %>
                    </td>

                    <td>

                        <a href="/order/<%= order.id %>">
                            보기
                        </a>

                    </td>

                </tr>

            <% }) %>

        </table>

    <% } %>

</div>

</body>
</html>