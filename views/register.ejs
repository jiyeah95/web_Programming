<h2>회원가입</h2>

<form action="/user/register" method="post">
    <input
            type="text"
            name="username"
            placeholder="아이디"
            required>

    <br><br>

    <input
            type="text"
            name="name"
            placeholder="이름"
            required>

    <br><br>

    <input
            type="password"
            name="password"
            placeholder="비밀번호"
            required>

    <br><br>

    <button type="submit">
        가입하기
    </button>

</form>