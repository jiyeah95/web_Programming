<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>과일 쇼핑몰</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <%- include('partials/header') %>
    <script>

        document.addEventListener("DOMContentLoaded", () => {

            const phrases = [

                "🍓 오늘의 신선한 과일을 만나보세요!",
                "🍌 인기 많은 과일을 지금 확인해보세요!",
                "🍊 달콤한 오렌지, 무료배송 중!",
                "🍇 포도로 건강 챙기세요!"

            ];

            const bannerText =
                document.getElementById("banner-text");

            let current = 0;

            setInterval(() => {

                current =
                    (current + 1) % phrases.length;

                bannerText.textContent =
                    phrases[current];

            }, 3000);

        });

    </script>

</head>

<body>

<div class="main-title">

    <h1>🍎 과일 쇼핑몰</h1>

    <p>
        신선한 과일을 합리적인 가격에 만나보세요.
    </p>

</div>

<div class="banner">

    <img
            src="/images/default.png"
            alt="대표 과일"
            class="banner-image"
    >

    <div id="banner-text" class="banner-text">

        🍓 오늘의 신선한 과일을 만나보세요!

    </div>

</div>

<hr>

<h2 class="section-title">
    ⭐ 추천 상품
</h2>

<div class="recommend">

    <a
            href="/product/detail/1"
            style="
            text-decoration:none;
            color:black;
        ">

        <div class="card">

            <img
                    src="/images/apple.png"
                    alt="추천상품1">

            <p>사과</p>

        </div>

    </a>

    <a
            href="/product/detail/4"
            style="
            text-decoration:none;
            color:black;
        ">

        <div class="card">

            <img
                    src="/images/orange.png"
                    alt="추천상품2">

            <p>오렌지</p>

        </div>

    </a>

    <a
            href="/product/detail/3"
            style="
            text-decoration:none;
            color:black;
        ">

        <div class="card">

            <img
                    src="/images/grape.png"
                    alt="추천상품3">

            <p>포도</p>

        </div>

    </a>

</div>

<footer>

    <hr>

    <p>
        Fruit Shopping Mall
    </p>

    <p>
        2026 Web Programming Project
    </p>

</footer>

</body>
</html>