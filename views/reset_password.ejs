<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>비밀번호 재설정</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<div class="member-container">

    <h2 class="member-title">
        비밀번호 재설정
    </h2>

    <form action="/user/reset-password" method="post">

        <input
                type="hidden"
                name="userId"
                value="<%= userId %>">

        <p>
            새 비밀번호
            <br>

            <input
                    type="password"
                    name="password"
                    class="member-input"
                    required>
        </p>

        <p>
            새 비밀번호 확인
            <br>

            <input
                    type="password"
                    name="password2"
                    class="member-input"
                    required>
        </p>

        <button
                type="submit"
                class="member-btn">

            변경하기

        </button>

        <a
                href="/user/login"
                class="cancel-btn">

            취소

        </a>

    </form>

</div>

</body>
</html>