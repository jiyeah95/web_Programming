<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>고객센터</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <%- include('partials/header') %>
</head>
<body>

<div class="page-title">

    <h1>📢 고객센터</h1>

    <p>
        문의사항을 남겨주세요.
    </p>

</div>

<div class="board-container">

    <div class="board-header">

        <a
                href="/board/write"
                class="write-btn"
        >
            글쓰기
        </a>

    </div>

    <% if(posts.length === 0){ %>

        <div class="empty-cart">

            등록된 게시글이 없습니다.

        </div>

    <% } else { %>

        <table class="board-table">

            <tr>
                <th>제목</th>
                <th>작성자</th>
                <th>작성일</th>
            </tr>

            <% posts.forEach(post => { %>

                <tr>

                    <td>

                        <a
                                href="/board/detail/<%= post.id %>"
                                class="board-link"
                        >

                            <% if(post.parent_id){ %>
                                └─ [답글]
                            <% } %>

                            <%= post.title %>

                        </a>

                    </td>

                    <td>
                        <%= post.author || "익명" %>
                    </td>
                    <td>
                        <%= post.created_at_kor %>
                    </td>

                </tr>

            <% }) %>

        </table>

    <% } %>

</div>

</body>
</html>