<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>답글 작성</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <%- include('partials/header') %>
</head>
<body>
<div class="page-title">

    <h1>💬 답글 작성</h1>

    <p>
        문의글에 대한 답변을 작성합니다.
    </p>

</div>

<div class="write-container">

    <p>

        원글 제목 :

        <strong>
            <%= parentTitle %>
        </strong>

    </p>

    <hr>

    <form action="/board/reply" method="post">

        <input
                type="hidden"
                name="parent_id"
                value="<%= parentId %>"
        >

        <input
                type="text"
                name="title"
                class="input-title"
                placeholder="답글 제목을 입력하세요"
                required
        >

        <br><br>

        <p>

            작성자 :

            <strong>
                <%= user.name %>
            </strong>

        </p>

        <label>

            <input
                    type="checkbox"
                    name="anonymous"
                    value="1"
            >

            익명으로 작성

        </label>

        <br><br>

        <textarea
                name="content"
                class="input-content"
                placeholder="답글 내용을 입력하세요"
                required
        ></textarea>

        <br><br>

        <button
                type="submit"
                class="save-btn"
        >
            답글 등록
        </button>

    </form>

</div>

</body>
</html>