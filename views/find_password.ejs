<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>비밀번호 찾기</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<div class="member-container">

    <h2 class="member-title">
        비밀번호 찾기
    </h2>

    <form action="/user/find-password" method="post">

        <p>
            아이디
            <br>
            <input
                    type="text"
                    name="username"
                    class="member-input"
                    required>
        </p>

        <p>
            이메일
            <br>
            <input
                    type="email"
                    name="email"
                    class="member-input"
                    required>
        </p>

        <button
                type="submit"
                class="member-btn">

            확인

        </button>

    </form>

</div>

</body>
</html>