<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>장바구니</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header>

    <div class="login-area">

        <% if(!user){ %>

            <a href="/user/login">로그인</a>
            |
            <a href="/user/register">회원가입</a>

        <% } else { %>

            <span>
                <%= user.name %>님 환영합니다.
            </span>

            |
            <a href="/user/logout">로그아웃</a>

        <% } %>

    </div>

</header>

<nav class="menu">

    <a href="/">홈</a>
    <a href="/product">추천상품</a>
    <a href="/product/all">전체상품</a>
    <a href="/cart">장바구니</a>
    <a href="/order">주문내역</a>
    <a href="/board">고객센터</a>

</nav>

<div class="page-title">

    <h1>🛒 장바구니</h1>

    <p>
        선택한 상품을 확인하세요.
    </p>

</div>

<div class="cart-container">

    <% if(cartItems.length === 0){ %>

        <div class="empty-cart">

            장바구니가 비어있습니다.

        </div>

    <% } else { %>

        <table class="cart-table">

            <tr>
                <th>상품명</th>
                <th>가격</th>
                <th>수량</th>
                <th>삭제</th>
            </tr>

            <% cartItems.forEach(item => { %>

                <tr>

                    <td>
                        <%= item.name %>
                    </td>

                    <td>
                        ₩<%= item.price.toLocaleString() %>
                    </td>

                    <td>

                        <form
                                action="/cart/minus/<%= item.id %>"
                                method="POST"
                                style="display:inline;"
                        >
                            <button class="qty-btn">-</button>
                        </form>

                        <strong>
                            <%= item.quantity %>
                        </strong>

                        <form
                                action="/cart/plus/<%= item.id %>"
                                method="POST"
                                style="display:inline;"
                        >
                            <button class="qty-btn">+</button>
                        </form>

                    </td>

                    <td>

                        <form
                                action="/cart/delete/<%= item.id %>"
                                method="POST"
                        >

                            <button class="delete-btn">
                                삭제
                            </button>

                        </form>

                    </td>

                </tr>

            <% }) %>

        </table>

        <div class="cart-summary">

            <h2>

                총 금액 :
                ₩<%= totalPrice.toLocaleString() %>

            </h2>

            <form
                    action="/order/create"
                    method="POST"
            >

                <button
                        type="submit"
                        class="order-btn"
                >
                    주문하기
                </button>

            </form>

        </div>

    <% } %>

</div>

</body>
</html>